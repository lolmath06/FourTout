{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FourTout",
  "version": "0.1.0",
  "identifier": "app.fourtout.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FourTout",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; child-src 'self' blob:; img-src 'self' data: blob:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Boîte à outils locale : PDF, image, audio, vidéo, texte, fichiers.",
    "longDescription": "FourTout regroupe dans une seule application desktop les petits outils du quotidien (PDF, images, audio, vidéo, texte, fichiers, développeur, calculateurs). Les traitements sont réalisés localement : vos fichiers ne quittent pas votre appareil.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/wordlists/seeds.txt.gz",
      "resources/wordlists/seeds.meta"
    ],
    "publisher": "Matheo Dolmen",
    "copyright": "© 2026 Matheo Dolmen. Tous droits réservés.",
    "linux": {
      "rpm": {
        "recommends": [
          "ffmpeg-free"
        ]
      },
      "deb": {
        "recommends": [
          "ffmpeg"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "French",
          "English"
        ]
      }
    },
    "license": "Proprietary",
    "licenseFile": "../LICENSE"
  }
}
