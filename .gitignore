# ---------------------------------------------------------------- dépendances
node_modules
.pnpm-store/

# ------------------------------------------------------------------- produits
# Sortie du bundler frontend et de Cargo. `src-tauri/target/` est également
# ignoré par `src-tauri/.gitignore`.
dist
dist-ssr
src-tauri/target/
src-tauri/gen/schemas
coverage
*.tsbuildinfo

# ---------------------------------------------------------------------- logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------- secrets
# FourTout n'a besoin d'aucune clé pour fonctionner. Ces règles existent pour
# qu'un fichier d'environnement local ne parte jamais par accident.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# -------------------------------------------------------------- fichiers temporaires
*.tmp
*.part
*.local
tmp/
temp/
outputs/

# -------------------------------------------------------- ressources régénérables
# Fixtures de test : régénérables par `pnpm test:assets`.
test-assets/generated/
# Ressources pdf.js copiées depuis node_modules (scripts/sync-pdfjs-assets.mjs).
public/pdfjs/
# Ressources OCR copiées ou téléchargées (scripts/sync-tesseract-assets.mjs).
public/tesseract/
public/tessdata/
# Moteur d'inférence ONNX copié depuis node_modules (scripts/sync-onnx-assets.mjs).
public/ort/
# Modèles (parole, détourage) : installés à la demande par le gestionnaire de
# modèles, dans le dossier de données de l'application — jamais dans le dépôt.
# Les motifs sont ancrés à la racine : un simple `models/` masquerait aussi
# `src-tauri/src/models/`, qui est du code source.
/models/
/test-assets/models/
*.onnx
*.gguf

# NB : `docs/assets/branding/` et `src-tauri/icons/` sont versionnés — ce sont
# l'identité visuelle et les icônes nécessaires à l'empaquetage.

# ------------------------------------------------------------------- éditeurs
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------- systèmes
.DS_Store
Thumbs.db

# -------------------------------------------------------- outillage de poste
# Configurations d'outils propres à une machine de développement. Elles
# n'aident ni un développeur ni un utilisateur du dépôt public, et ne doivent
# donc jamais y arriver.
.claude/
.aider*
.cursor/
*.local.md
